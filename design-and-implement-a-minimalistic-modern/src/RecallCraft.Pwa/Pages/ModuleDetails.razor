@page "/module/{ModuleId:guid}"
@inject ModuleViewModel ViewModel
@inject NavigationManager Navigation
@inject IJSRuntime Js
@implements IAsyncDisposable

<PageTitle>@(ViewModel.Module?.Name ?? "Module") - Flashcards</PageTitle>

<section class="screen module-screen">
    @if (ViewModel.Module is null)
    {
        <section class="empty">
            <h2>Module not found</h2>
        </section>
    }
    else if (ViewModel.LearningMode == LearningMode.None)
    {
        <nav class="subnav">
            <button @onclick="GoHome" title="Back">‹</button>
            <strong>Module</strong>
        </nav>

        <header class="module-hero">
            <div style="display: flex; gap: 8px; align-items: center; width: 100%;">
                <input class="module-title-input" value="@ViewModel.Module.Name" @onchange="RenameModule" aria-label="Module name" style="flex: 1;" />
                <button class="icon-button" @onclick="DeleteModule" title="Delete Module">🗑</button>
            </div>
            
            <div class="metric-grid">
                <span>
                    <small>@ViewModel.StageDateLabel</small>
                    <strong>@ViewModel.StageDateText</strong>
                </span>
                <span>
                    <small>Cards</small>
                    <strong>@ViewModel.TotalWordsCount</strong>
                </span>
                <span>
                    <small>Progress</small>
                    <strong>@ViewModel.LearningProgress%</strong>
                </span>
            </div>
            <div class="progress-track">
                <span style="width:@ViewModel.LearningProgress%"></span>
            </div>
            <div class="sync-strip">
                <span class="sync-dot @ViewModel.SyncStatus.ToString().ToLowerInvariant()"></span>
                <span>@SyncLabel</span>
                <button class="sync-button @(ViewModel.SyncStatus == ModuleSyncStatus.Syncing ? "is-loading" : null)" @onclick="ForceSync" disabled="@(ViewModel.SyncStatus == ModuleSyncStatus.Syncing)" title="Sync">↻</button>
            </div>
        </header>
        
        <section class="learning-panel">
            <label class="toggle-row">
                <span>Flip mode</span>
                <input type="checkbox" @bind="ViewModel.FlipLearningSides" />
            </label>
            <div class="learning-actions">
                <button @onclick="() => StartLearning(LearningMode.Card)">Card Mode</button>
                <button @onclick="() => StartLearning(LearningMode.Writing)">Writing Mode</button>
            </div>
        </section>

        <section class="cards-list" @onscroll="HandleScroll">
            @foreach (var card in ViewModel.VisibleCards)
            {
                <article class="editable-card @(DeletingCardIds.Contains(card.Id) ? "is-deleting" : null)">
                    <button class="delete-card-button" @onclick="() => DeleteCard(card)" disabled="@DeletingCardIds.Contains(card.Id)" title="Delete card">×</button>
                    <input class="card-front" placeholder="Front" @bind="card.FrontText" @bind:event="oninput" @onblur="() => SaveCard(card)" />
                    <div class="card-divider"></div>
                    <textarea class="card-back" placeholder="Back" @bind="card.BackText" @bind:event="oninput" @onblur="() => SaveCard(card)"></textarea>
                </article>
            }

            <div class="scroll-sentinel" @ref="ScrollSentinel"></div>
            <button class="add-card-button" @onclick="CreateCard">+</button>
        </section>

    }
    else
    {
        <section class="learning-view">
            <nav class="subnav">
                <button @onclick="StopLearning" title="Back">‹</button>
                <strong>@(ViewModel.LearningMode == LearningMode.Card ? "Card Mode" : "Writing Mode")</strong>
                <small>@ViewModel.SessionMasteredCount/@ViewModel.SessionTotalCount</small>
            </nav>

            @if (ViewModel.CurrentLearningCard is null)
            {
                <section class="empty">
                    <h2>@ViewModel.SessionCompleteTitle</h2>
                    <p>@ViewModel.SessionCompleteText</p>
                    <button @onclick="StopLearning">Done</button>
                </section>
            }
            else if (ViewModel.LearningMode == LearningMode.Card)
            {
                <div class="learning-card-wrap">
                    <button class="learning-card @(ViewModel.IsAnswerVisible ? "flipped" : null)" @onclick="FlipCard">
                        <span>@(ViewModel.IsAnswerVisible ? ViewModel.AnswerText(ViewModel.CurrentLearningCard) : ViewModel.PromptText(ViewModel.CurrentLearningCard))</span>
                    </button>
                    <button class="audio-icon @(IsAudioLoading ? "is-loading" : null)" @onclick="PlayAudio" disabled="@IsAudioLoading" title="Play audio">♪</button>
                </div>
                <div class="grade-grid">
                    <button class="again" @onclick="() => Grade(ReviewGrade.Again)">Again</button>
                    <button class="hard" @onclick="() => Grade(ReviewGrade.Hard)">Hard</button>
                    <button class="good" @onclick="() => Grade(ReviewGrade.Good)">Good</button>
                    <button class="easy" @onclick="() => Grade(ReviewGrade.Easy)">Easy</button>
                </div>
            }
            else
            {
                <article class="writing-card">
                    <strong>@ViewModel.PromptText(ViewModel.CurrentLearningCard)</strong>
                    <input placeholder="Type answer" @bind="ViewModel.WritingAnswer" @bind:event="oninput" />
                    <button @onclick="SubmitWriting">Check</button>
                    @if (!string.IsNullOrWhiteSpace(ViewModel.WritingResult))
                    {
                        <p>@ViewModel.WritingResult</p>
                    }
                </article>
            }
        </section>
    }
</section>

@code {
    [Parameter]
    public Guid ModuleId { get; set; }

    private ElementReference ScrollSentinel;
    private DotNetObjectReference<ModuleDetails>? ObjectReference;
    private IJSObjectReference? InfiniteScrollObserver;
    private readonly HashSet<Guid> DeletingCardIds = [];
    private bool IsAudioLoading;

    private string SyncLabel => ViewModel.SyncStatus switch
    {
        ModuleSyncStatus.NotSynced => "Not Synced",
        ModuleSyncStatus.Syncing => "Syncing",
        ModuleSyncStatus.Synced => "Synced",
        ModuleSyncStatus.Error => "Error",
        _ => "Not Synced"
    };

    private int MaxStageCount => Math.Max(1, ViewModel.LearningStageStats.Max(x => x.Count));

    private int StageHeight(int count) => count == 0 ? 0 : Math.Max(8, (int)Math.Round(count * 100d / MaxStageCount));

    protected override async Task OnParametersSetAsync() =>
        await ViewModel.LoadAsync(ModuleId, CancellationToken.None);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            ObjectReference = DotNetObjectReference.Create(this);
            InfiniteScrollObserver = await Js.InvokeAsync<IJSObjectReference>("recallCraft.observeInfiniteScroll", ScrollSentinel, ObjectReference);
        }
    }

    private void GoHome() => Navigation.NavigateTo("/");

    private async Task RenameModule(ChangeEventArgs args)
    {
        await ViewModel.RenameModuleAsync(args.Value?.ToString() ?? string.Empty, CancellationToken.None);
        StateHasChanged();
    }

    private async Task DeleteModule()
    {
        await ViewModel.DeleteModuleAsync(CancellationToken.None);
        Navigation.NavigateTo("/");
    }

    private async Task SaveCard(Card card)
    {
        await ViewModel.UpdateCardAsync(card, CancellationToken.None);
        StateHasChanged();
    }

    private async Task DeleteCard(Card card)
    {
        DeletingCardIds.Add(card.Id);
        StateHasChanged();
        await Task.Delay(180);
        await ViewModel.DeleteCardAsync(card, CancellationToken.None);
        DeletingCardIds.Remove(card.Id);
        StateHasChanged();
    }

    private async Task CreateCard()
    {
        await ViewModel.CreateCardAsync(CancellationToken.None);
        StateHasChanged();
    }

    private async Task ForceSync()
    {
        await ViewModel.ForceSyncAsync(CancellationToken.None);
        StateHasChanged();
    }

    [JSInvokable]
    public void LoadMoreCards()
    {
        if (ViewModel.HasMoreCards)
        {
            ViewModel.LoadMoreCards();
            StateHasChanged();
        }
    }

    private void HandleScroll() { }

    private void StartLearning(LearningMode mode) => ViewModel.StartLearning(mode);

    private void StopLearning() => ViewModel.StopLearning();

    private void FlipCard() => ViewModel.FlipCard();

    private async Task PlayAudio()
    {
        IsAudioLoading = true;
        StateHasChanged();
        try
        {
            await Js.InvokeVoidAsync("recallCraft.primeAudio");
            await ViewModel.PlayAudioAsync(CancellationToken.None);
        }
        finally
        {
            IsAudioLoading = false;
            StateHasChanged();
        }
    }

    private async Task Grade(ReviewGrade grade)
    {
        await ViewModel.GradeCurrentAsync(grade, CancellationToken.None);
        StateHasChanged();
    }

    private async Task SubmitWriting()
    {
        await ViewModel.SubmitWritingAsync(CancellationToken.None);
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (InfiniteScrollObserver is not null)
        {
            await InfiniteScrollObserver.DisposeAsync();
        }

        ObjectReference?.Dispose();
    }
}
